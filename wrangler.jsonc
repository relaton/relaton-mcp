{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-relaton-org",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "API_BASE": "https://api-relaton-org.relaton.workers.dev" },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [{ "pattern": "mcp.relaton.org", "custom_domain": true }]
}
